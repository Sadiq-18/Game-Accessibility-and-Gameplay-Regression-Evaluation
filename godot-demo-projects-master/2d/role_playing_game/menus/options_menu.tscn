[gd_scene format=3]

[ext_resource type="Script" path="res://menus/options_menu.gd" id="1"]

[node name="OptionsMenu" type="CanvasLayer"]
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="OptionsButton" type="Button" parent="Root"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -190.0
offset_top = 12.0
offset_right = -20.0
offset_bottom = 62.0
grow_horizontal = 0
text = "Options"

[node name="SettingsPanel" type="PanelContainer" parent="Root"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -280.0
offset_top = -120.0
offset_right = 280.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Root/SettingsPanel"]
layout_mode = 2

[node name="Title" type="Label" parent="Root/SettingsPanel/VBox"]
layout_mode = 2
text = "Accessibility Options"
horizontal_alignment = 1

[node name="HighContrast" type="CheckButton" parent="Root/SettingsPanel/VBox"]
layout_mode = 2
text = "High contrast battle and dialogue"

[node name="CloseButton" type="Button" parent="Root/SettingsPanel/VBox"]
layout_mode = 2
text = "Close"

[connection signal="pressed" from="Root/OptionsButton" to="." method="_on_options_button_pressed"]
[connection signal="pressed" from="Root/SettingsPanel/VBox/CloseButton" to="." method="_on_close_button_pressed"]
[connection signal="toggled" from="Root/SettingsPanel/VBox/HighContrast" to="." method="_on_high_contrast_toggled"]
