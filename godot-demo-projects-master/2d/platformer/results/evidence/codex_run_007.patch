diff --git a/2d/platformer/gui/pause_menu.gd b/2d/platformer/gui/pause_menu.gd
index a89c899..b1c981d 100644
--- a/2d/platformer/gui/pause_menu.gd
+++ b/2d/platformer/gui/pause_menu.gd
@@ -5,13 +5,101 @@ extends Control
 @export var fade_in_duration := 0.3
 @export var fade_out_duration := 0.2
 
+const REMAPPABLE_ACTIONS := ["move_left", "move_right", "jump", "shoot"]
+static var remapped_physical_keys: Dictionary = {}
+static var reduced_motion_enabled: bool = false
+
 @onready var center_cont := $ColorRect/CenterContainer as CenterContainer
+@onready var remap_controls := center_cont.get_node(^"VBoxContainer/RemapControls") as VBoxContainer
 @onready var resume_button := center_cont.get_node(^"VBoxContainer/ResumeButton") as Button
 @onready var coins_counter := $ColorRect/CoinsCounter as CoinsCounter
+@onready var reduced_motion_button := $ColorRect/CenterContainer/VBoxContainer/ReducedMotionButton as CheckButton
+var awaiting_remap_action: String = ""
+var parallax_background: ParallaxBackground
+var original_base_scale := Vector2.ZERO
+var original_layer_scales: Array[Vector2] = []
 
 
 func _ready() -> void:
 	hide()
+	for action in REMAPPABLE_ACTIONS:
+		_update_remap_button(action)
+	reduced_motion_button.button_pressed = reduced_motion_enabled
+	var roots := get_tree().root.find_children("*", "ParallaxBackground", true, false)
+	if not roots.is_empty():
+		parallax_background = roots[0] as ParallaxBackground
+		original_base_scale = parallax_background.scroll_base_scale
+		for layer in parallax_background.get_children():
+			if layer is ParallaxLayer:
+				original_layer_scales.append(layer.motion_scale)
+		_apply_reduced_motion()
+	set_process_unhandled_key_input(true)
+
+
+func _on_reduced_motion_toggled(enabled: bool) -> void:
+	reduced_motion_enabled = enabled
+	_apply_reduced_motion()
+
+
+func _apply_reduced_motion() -> void:
+	if not is_instance_valid(parallax_background):
+		return
+	parallax_background.scroll_base_scale = Vector2.ZERO if reduced_motion_enabled else original_base_scale
+	var index := 0
+	for layer in parallax_background.get_children():
+		if layer is ParallaxLayer:
+			var scale: Vector2 = original_layer_scales[index]
+			layer.motion_scale = Vector2.ZERO if reduced_motion_enabled else scale
+			index += 1
+
+
+func _on_remap_button_pressed(action: String) -> void:
+	if action not in REMAPPABLE_ACTIONS:
+		return
+	awaiting_remap_action = action
+	var button := _remap_button(action)
+	if button:
+		button.text = "Press a key..."
+
+
+func _unhandled_key_input(event: InputEvent) -> void:
+	if awaiting_remap_action.is_empty() or not event is InputEventKey or not event.pressed or event.echo:
+		return
+	var key_event := event as InputEventKey
+	if key_event.keycode == KEY_ESCAPE:
+		return
+	var remapped := InputEventKey.new()
+	remapped.physical_keycode = key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
+	for existing in InputMap.action_get_events(awaiting_remap_action):
+		if existing is InputEventKey:
+			InputMap.action_erase_event(awaiting_remap_action, existing)
+	InputMap.action_add_event(awaiting_remap_action, remapped)
+	remapped_physical_keys[awaiting_remap_action] = remapped.physical_keycode
+	var action := awaiting_remap_action
+	awaiting_remap_action = ""
+	_update_remap_button(action)
+	get_viewport().set_input_as_handled()
+
+
+func _remap_button(action: String) -> Button:
+	return remap_controls.get_node_or_null(action + "Button") as Button
+
+
+func _update_remap_button(action: String) -> void:
+	var button := _remap_button(action)
+	if not button:
+		return
+	var keycode: int = remapped_physical_keys.get(action, _default_key_for(action))
+	button.text = "%s: %s" % [action.replace("_", " ").capitalize(), OS.get_keycode_string(keycode)]
+
+
+func _default_key_for(action: String) -> int:
+	match action:
+		"move_left": return KEY_A
+		"move_right": return KEY_D
+		"jump": return KEY_W
+		"shoot": return KEY_SPACE
+	return 0
 
 
 func close() -> void:
