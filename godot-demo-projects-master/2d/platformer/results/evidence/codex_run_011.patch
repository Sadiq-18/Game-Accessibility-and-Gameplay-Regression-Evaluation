diff --git a/2d/platformer/level/caption_overlay.gd b/2d/platformer/level/caption_overlay.gd
new file mode 100644
index 0000000..5f0f039
--- /dev/null
+++ b/2d/platformer/level/caption_overlay.gd
@@ -0,0 +1,13 @@
+extends CanvasLayer
+
+@onready var panel := $CaptionPanel as PanelContainer
+@onready var caption_label := $CaptionPanel/CaptionLabel as Label
+@onready var timer := $Timer as Timer
+
+func show_caption(caption: String) -> void:
+	caption_label.text = caption
+	panel.show()
+	timer.start()
+
+func _on_timer_timeout() -> void:
+	panel.hide()
