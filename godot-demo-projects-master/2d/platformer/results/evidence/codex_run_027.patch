diff --git a/2d/role_playing_game/menus/options_menu.gd b/2d/role_playing_game/menus/options_menu.gd
new file mode 100644
index 0000000..d75fd21
--- /dev/null
+++ b/2d/role_playing_game/menus/options_menu.gd
@@ -0,0 +1,58 @@
+extends CanvasLayer
+
+const REMAPPABLE_ACTIONS := ["move_up", "move_down", "move_left", "move_right", "ui_accept", "ui_cancel"]
+var awaiting_action := ""
+
+@onready var settings_panel := $Root/SettingsPanel as PanelContainer
+@onready var remap_buttons := $Root/SettingsPanel/Margin/VBox/RemapButtons as VBoxContainer
+
+func _ready() -> void:
+	for action in REMAPPABLE_ACTIONS:
+		_update_button(action)
+	set_process_unhandled_key_input(true)
+
+
+func _on_options_button_pressed() -> void:
+	settings_panel.visible = not settings_panel.visible
+
+
+func _on_close_button_pressed() -> void:
+	settings_panel.hide()
+
+
+func _on_remap_pressed(action: String) -> void:
+	if action not in REMAPPABLE_ACTIONS:
+		return
+	awaiting_action = action
+	(remap_buttons.get_node(action + "Button") as Button).text = "%s: press a key" % action.replace("_", " ").capitalize()
+
+
+func _unhandled_key_input(event: InputEvent) -> void:
+	if awaiting_action.is_empty() or not event is InputEventKey or not event.pressed or event.echo:
+		return
+	var key_event := event as InputEventKey
+	if key_event.keycode == KEY_ESCAPE and awaiting_action != "ui_cancel":
+		var cancelled := awaiting_action
+		awaiting_action = ""
+		_update_button(cancelled)
+		get_viewport().set_input_as_handled()
+		return
+	var action := awaiting_action
+	var replacement := InputEventKey.new()
+	replacement.physical_keycode = key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
+	for old_event in InputMap.action_get_events(action):
+		if old_event is InputEventKey:
+			InputMap.action_erase_event(action, old_event)
+	InputMap.action_add_event(action, replacement)
+	awaiting_action = ""
+	_update_button(action)
+	get_viewport().set_input_as_handled()
+
+
+func _update_button(action: String) -> void:
+	var key_name := "Not assigned"
+	for event in InputMap.action_get_events(action):
+		if event is InputEventKey:
+			key_name = OS.get_keycode_string(event.physical_keycode if event.physical_keycode != 0 else event.keycode)
+			break
+	(remap_buttons.get_node(action + "Button") as Button).text = "%s: %s" % [action.replace("_", " ").capitalize(), key_name]
