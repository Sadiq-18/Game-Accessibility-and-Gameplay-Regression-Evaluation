index b4504f1..0b7a23b 100644
--- a/2d/dodge_the_creeps/hud.gd
+++ b/2d/dodge_the_creeps/hud.gd
@@ -1,6 +1,47 @@
 extends CanvasLayer
 
 signal start_game
+@onready var spawn_warning := $SpawnWarning as PanelContainer
+@onready var spawn_arrow := $SpawnWarning/Arrow as Label
+@onready var warning_flash_timer := $WarningFlashTimer as Timer
+@onready var warning_timer := $WarningTimer as Timer
+
+func show_spawn_warning(world_position: Vector2) -> void:
+	var viewport_size := get_viewport().get_visible_rect().size
+	var direction := world_position - viewport_size / 2.0
+	var position := Vector2.ZERO
+	if absf(direction.x) >= absf(direction.y):
+		if direction.x < 0.0:
+			spawn_arrow.text = "<"
+			position = Vector2(4.0, clampf(world_position.y - 24.0, 4.0, viewport_size.y - 52.0))
+		else:
+			spawn_arrow.text = ">"
+			position = Vector2(viewport_size.x - 52.0, clampf(world_position.y - 24.0, 4.0, viewport_size.y - 52.0))
+	else:
+		if direction.y < 0.0:
+			spawn_arrow.text = "^"
+			position = Vector2(clampf(world_position.x - 24.0, 4.0, viewport_size.x - 52.0), 4.0)
+		else:
+			spawn_arrow.text = "v"
+			position = Vector2(clampf(world_position.x - 24.0, 4.0, viewport_size.x - 52.0), viewport_size.y - 52.0)
+	spawn_warning.position = position
+	spawn_warning.show()
+	warning_flash_timer.start()
+	warning_timer.start()
+
+
+func hide_spawn_warning() -> void:
+	warning_timer.stop()
+	warning_flash_timer.stop()
+	spawn_warning.hide()
+
+
+func _on_warning_flash_timeout() -> void:
+	spawn_warning.visible = not spawn_warning.visible
+
+
+func _on_warning_timer_timeout() -> void:
+	hide_spawn_warning()
 
 func show_message(text):
 	$MessageLabel.text = text
