+++ b/2d/platformer/player/player.gd
@@ -21,9 +21,17 @@ const TERMINAL_VELOCITY = 700
 @onready var jump_sound := $Jump as AudioStreamPlayer2D
 @onready var gun: Gun = sprite.get_node(^"Gun")
 @onready var camera := $Camera as Camera2D
+@onready var player_badge := $PlayerBadge as PanelContainer
+@onready var player_badge_label := $PlayerBadge/BadgeText as Label
 var _double_jump_charged: bool = false
 
 
+func _ready() -> void:
+	player_badge.visible = action_suffix == "_p1" or action_suffix == "_p2"
+	if player_badge.visible:
+		player_badge_label.text = "P1" if action_suffix == "_p1" else "P2"
+
+
 func _physics_process(delta: float) -> void:
 	if is_on_floor():
 		_double_jump_charged = true
