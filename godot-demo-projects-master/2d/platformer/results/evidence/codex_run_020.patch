diff --git a/2d/dodge_the_creeps/hud.gd b/2d/dodge_the_creeps/hud.gd
index b4504f1..e1fea22 100644
--- a/2d/dodge_the_creeps/hud.gd
+++ b/2d/dodge_the_creeps/hud.gd
@@ -1,6 +1,26 @@
 extends CanvasLayer
 
 signal start_game
+static var ui_scale_index: int = 0
+@onready var ui_scale_option := $UIScaleOption as OptionButton
+
+func _ready() -> void:
+	ui_scale_option.add_item("100% HUD")
+	ui_scale_option.add_item("125% HUD")
+	ui_scale_option.add_item("150% HUD")
+	ui_scale_option.select(ui_scale_index)
+	_apply_ui_scale()
+
+
+func _on_ui_scale_selected(index: int) -> void:
+	ui_scale_index = clampi(index, 0, 2)
+	_apply_ui_scale()
+
+
+func _apply_ui_scale() -> void:
+	var scale_value: float = [1.0, 1.25, 1.5][ui_scale_index]
+	var viewport_size := get_viewport().get_visible_rect().size
+	transform = Transform2D(Vector2(scale_value, 0), Vector2(0, scale_value), viewport_size * (1.0 - scale_value) / 2.0)
 
 func show_message(text):
 	$MessageLabel.text = text
