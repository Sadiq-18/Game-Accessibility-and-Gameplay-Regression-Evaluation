diff --git a/2d/platformer/gui/pause_menu.gd b/2d/platformer/gui/pause_menu.gd
index a89c899..9a0e74f 100644
--- a/2d/platformer/gui/pause_menu.gd
+++ b/2d/platformer/gui/pause_menu.gd
@@ -5,13 +5,54 @@ extends Control
 @export var fade_in_duration := 0.3
 @export var fade_out_duration := 0.2
 
+static var high_contrast_enabled: bool = false
+
 @onready var center_cont := $ColorRect/CenterContainer as CenterContainer
 @onready var resume_button := center_cont.get_node(^"VBoxContainer/ResumeButton") as Button
+@onready var high_contrast_toggle := center_cont.get_node(^"VBoxContainer/HighContrastToggle") as CheckButton
 @onready var coins_counter := $ColorRect/CoinsCounter as CoinsCounter
 
 
 func _ready() -> void:
 	hide()
+	high_contrast_toggle.button_pressed = high_contrast_enabled
+	_apply_high_contrast(high_contrast_enabled)
+
+
+func _on_high_contrast_toggled(enabled: bool) -> void:
+	high_contrast_enabled = enabled
+	_apply_high_contrast(enabled)
+
+
+func _apply_high_contrast(enabled: bool) -> void:
+	for control in find_children("*", "Button", true, false):
+		var button := control as Button
+		if not enabled:
+			for color_name in [&"font_color", &"font_color_hover", &"font_color_pressed", &"font_color_hover_pressed"]:
+				button.remove_theme_color_override(color_name)
+			for style_name in [&"normal", &"hover", &"pressed", &"focus"]:
+				button.remove_theme_stylebox_override(style_name)
+			continue
+		button.add_theme_color_override(&"font_color", Color.BLACK)
+		button.add_theme_color_override(&"font_color_hover", Color.BLACK)
+		button.add_theme_color_override(&"font_color_pressed", Color.WHITE)
+		button.add_theme_color_override(&"font_color_hover_pressed", Color.WHITE)
+		var normal := _contrast_style(Color.WHITE, Color.BLACK, 2)
+		var hover := _contrast_style(Color.YELLOW, Color.BLACK, 2)
+		var pressed := _contrast_style(Color.BLACK, Color.WHITE, 2)
+		var focus := _contrast_style(Color.YELLOW, Color.BLACK, 4)
+		button.add_theme_stylebox_override(&"normal", normal)
+		button.add_theme_stylebox_override(&"hover", hover)
+		button.add_theme_stylebox_override(&"pressed", pressed)
+		button.add_theme_stylebox_override(&"focus", focus)
+
+
+func _contrast_style(background: Color, border: Color, width: int) -> StyleBoxFlat:
+	var style := StyleBoxFlat.new()
+	style.bg_color = background
+	style.border_color = border
+	style.set_border_width_all(width)
+	return style
 
 
 func close() -> void:
