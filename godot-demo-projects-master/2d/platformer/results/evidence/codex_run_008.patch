diff --git a/2d/platformer/gui/pause_menu.gd b/2d/platformer/gui/pause_menu.gd
index a89c899..9b4f4ef 100644
--- a/2d/platformer/gui/pause_menu.gd
+++ b/2d/platformer/gui/pause_menu.gd
@@ -5,13 +5,35 @@ extends Control
 @export var fade_in_duration := 0.3
 @export var fade_out_duration := 0.2
 
+static var ui_scale_index: int = 0
+
 @onready var center_cont := $ColorRect/CenterContainer as CenterContainer
 @onready var resume_button := center_cont.get_node(^"VBoxContainer/ResumeButton") as Button
 @onready var coins_counter := $ColorRect/CoinsCounter as CoinsCounter
+@onready var ui_scale_option := $ColorRect/CenterContainer/VBoxContainer/UIScaleOption as OptionButton
+@onready var interface_layer := get_parent() as CanvasLayer
 
 
 func _ready() -> void:
 	hide()
+	ui_scale_option.add_item("100%")
+	ui_scale_option.add_item("125%")
+	ui_scale_option.add_item("150%")
+	ui_scale_option.select(ui_scale_index)
+	_apply_ui_scale()
+
+
+func _on_ui_scale_selected(index: int) -> void:
+	ui_scale_index = clampi(index, 0, 2)
+	_apply_ui_scale()
+
+
+func _apply_ui_scale() -> void:
+	if not is_instance_valid(interface_layer):
+		return
+	var scale_value: float = [1.0, 1.25, 1.5][ui_scale_index]
+	var viewport_size := get_viewport().get_visible_rect().size
+	interface_layer.transform = Transform2D(Vector2(scale_value, 0), Vector2(0, scale_value), viewport_size * (1.0 - scale_value) / 2.0)
 
 
 func close() -> void:
