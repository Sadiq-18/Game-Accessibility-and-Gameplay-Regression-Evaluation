diff --git a/2d/platformer/gui/pause_menu.gd b/2d/platformer/gui/pause_menu.gd
index a89c899..caca1f5 100644
--- a/2d/platformer/gui/pause_menu.gd
+++ b/2d/platformer/gui/pause_menu.gd
@@ -5,13 +5,39 @@ extends Control
 @export var fade_in_duration := 0.3
 @export var fade_out_duration := 0.2
 
+const MUTE_BUSES := ["Master", "Music", "SFX"]
+static var muted_buses: Dictionary = {"Master": false, "Music": false, "SFX": false}
+static var saved_bus_volume_db: Dictionary = {}
+
 @onready var center_cont := $ColorRect/CenterContainer as CenterContainer
 @onready var resume_button := center_cont.get_node(^"VBoxContainer/ResumeButton") as Button
+@onready var mute_controls := center_cont.get_node(^"VBoxContainer/MuteControls") as VBoxContainer
 @onready var coins_counter := $ColorRect/CoinsCounter as CoinsCounter
 
 
 func _ready() -> void:
 	hide()
+	for bus_name in MUTE_BUSES:
+		var index := AudioServer.get_bus_index(bus_name)
+		if index < 0:
+			continue
+		if not saved_bus_volume_db.has(bus_name):
+			saved_bus_volume_db[bus_name] = AudioServer.get_bus_volume_db(index)
+		AudioServer.set_bus_mute(index, bool(muted_buses.get(bus_name, false)))
+		var control := mute_controls.get_node(bus_name + "Mute") as CheckButton
+		control.button_pressed = bool(muted_buses.get(bus_name, false))
+
+
+func _on_bus_mute_toggled(is_muted: bool, bus_name: String) -> void:
+	var index := AudioServer.get_bus_index(bus_name)
+	if index < 0:
+		return
+	if is_muted and not bool(muted_buses.get(bus_name, false)):
+		saved_bus_volume_db[bus_name] = AudioServer.get_bus_volume_db(index)
+	AudioServer.set_bus_mute(index, is_muted)
+	muted_buses[bus_name] = is_muted
+	if not is_muted:
+		AudioServer.set_bus_volume_db(index, float(saved_bus_volume_db[bus_name]))
 
 
 func close() -> void:
