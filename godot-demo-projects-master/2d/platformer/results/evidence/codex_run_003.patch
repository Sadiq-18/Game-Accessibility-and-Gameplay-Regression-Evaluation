diff --git a/2d/platformer/gui/pause_menu.gd b/2d/platformer/gui/pause_menu.gd
index a89c899..ba15952 100644
--- a/2d/platformer/gui/pause_menu.gd
+++ b/2d/platformer/gui/pause_menu.gd
@@ -5,13 +5,48 @@ extends Control
 @export var fade_in_duration := 0.3
 @export var fade_out_duration := 0.2
 
+static var master_volume: float = 0.2526
+static var music_volume: float = 1.0
+static var sfx_volume: float = 1.0
+
 @onready var center_cont := $ColorRect/CenterContainer as CenterContainer
 @onready var resume_button := center_cont.get_node(^"VBoxContainer/ResumeButton") as Button
+@onready var master_slider := center_cont.get_node(^"VBoxContainer/AudioControls/MasterSlider") as HSlider
+@onready var music_slider := center_cont.get_node(^"VBoxContainer/AudioControls/MusicSlider") as HSlider
+@onready var sfx_slider := center_cont.get_node(^"VBoxContainer/AudioControls/SFXSlider") as HSlider
 @onready var coins_counter := $ColorRect/CoinsCounter as CoinsCounter
 
 
 func _ready() -> void:
 	hide()
+	master_slider.value = master_volume
+	music_slider.value = music_volume
+	sfx_slider.value = sfx_volume
+	_apply_audio_volume("Master", master_volume)
+	_apply_audio_volume("Music", music_volume)
+	_apply_audio_volume("SFX", sfx_volume)
+
+
+func _on_master_slider_value_changed(value: float) -> void:
+	master_volume = value
+	_apply_audio_volume("Master", value)
+
+
+func _on_music_slider_value_changed(value: float) -> void:
+	music_volume = value
+	_apply_audio_volume("Music", value)
+
+
+func _on_sfx_slider_value_changed(value: float) -> void:
+	sfx_volume = value
+	_apply_audio_volume("SFX", value)
+
+
+func _apply_audio_volume(bus_name: String, value: float) -> void:
+	var bus_index := AudioServer.get_bus_index(bus_name)
+	if bus_index < 0:
+		return
+	AudioServer.set_bus_volume_db(bus_index, linear_to_db(maxf(value, 0.0001)))
 
 
 func close() -> void:
