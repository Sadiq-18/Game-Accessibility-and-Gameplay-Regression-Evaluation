@@ -0,0 +1,8 @@
+extends CanvasLayer
+
+func _on_bus_volume_changed(value: float, bus_name: String) -> void:
+	var bus_index := AudioServer.get_bus_index(bus_name)
+	if bus_index < 0:
+		return
+	var linear_gain := value / 100.0
+	AudioServer.set_bus_volume_db(bus_index, linear_to_db(maxf(linear_gain, 0.0001)))
