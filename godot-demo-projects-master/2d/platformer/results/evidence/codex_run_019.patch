diff --git a/2d/dodge_the_creeps/hud.gd b/2d/dodge_the_creeps/hud.gd
index b4504f1..0664b6c 100644
--- a/2d/dodge_the_creeps/hud.gd
+++ b/2d/dodge_the_creeps/hud.gd
@@ -1,6 +1,30 @@
+class_name HUD
 extends CanvasLayer
 
 signal start_game
+static var text_size_index: int = 0
+@onready var score_label := $ScoreLabel as Label
+@onready var message_label := $MessageLabel as Label
+@onready var text_size_option := $TextSizeOption as OptionButton
+
+func _ready() -> void:
+	text_size_option.add_item("Normal text")
+	text_size_option.add_item("Large text")
+	text_size_option.select(text_size_index)
+	_apply_text_size()
+
+
+func _on_text_size_selected(index: int) -> void:
+	text_size_index = clampi(index, 0, 1)
+	_apply_text_size()
+
+
+func _apply_text_size() -> void:
+	for label in [score_label, message_label]:
+		if text_size_index == 1:
+			label.add_theme_font_size_override("font_size", 84)
+		else:
+			label.add_theme_font_size_override("font_size", 60)
 
 func show_message(text):
 	$MessageLabel.text = text
