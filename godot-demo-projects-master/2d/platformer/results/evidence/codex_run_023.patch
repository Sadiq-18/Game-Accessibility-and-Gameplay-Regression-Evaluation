diff --git a/2d/dodge_the_creeps/hud.gd b/2d/dodge_the_creeps/hud.gd
index b4504f1..38457a2 100644
--- a/2d/dodge_the_creeps/hud.gd
+++ b/2d/dodge_the_creeps/hud.gd
@@ -1,6 +1,8 @@
 extends CanvasLayer
 
 signal start_game
+@onready var death_fade := $DeathFade as ColorRect
+var _death_fade_tween: Tween
 
 func show_message(text):
 	$MessageLabel.text = text
@@ -9,6 +11,8 @@ func show_message(text):
 
 
 func show_game_over():
+	begin_death_fade()
+	await _death_fade_tween.finished
 	show_message("Game Over")
 	await $MessageTimer.timeout
 	$MessageLabel.text = "Dodge the\nCreeps"
@@ -17,6 +21,22 @@ func show_game_over():
 	$StartButton.show()
 
 
+func begin_death_fade() -> void:
+	if _death_fade_tween and _death_fade_tween.is_running():
+		_death_fade_tween.kill()
+	death_fade.color = Color(0, 0, 0, 0)
+	death_fade.show()
+	_death_fade_tween = create_tween()
+	_death_fade_tween.tween_property(death_fade, "color:a", 0.28, 0.45).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
+
+
+func reset_death_fade() -> void:
+	if _death_fade_tween and _death_fade_tween.is_running():
+		_death_fade_tween.kill()
+	death_fade.color = Color(0, 0, 0, 0)
+	death_fade.hide()
+
+
 func update_score(score):
 	$ScoreLabel.text = str(score)
 
