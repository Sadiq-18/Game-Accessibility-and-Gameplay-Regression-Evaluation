@@ -1,9 +1,41 @@
 extends Control
 
 var dialogue_node: Node = null
+@onready var background_opacity_slider := $BackgroundOpacity as HSlider
+@onready var text_color_option := $TextColorOption as OptionButton
 
 func _ready() -> void:
 	visible = false
+	text_color_option.add_item("White text")
+	text_color_option.add_item("Yellow text")
+	text_color_option.add_item("Cyan text")
+	if not Engine.has_meta("gab_rpg_dialogue_opacity"):
+		Engine.set_meta("gab_rpg_dialogue_opacity", 0.85)
+	if not Engine.has_meta("gab_rpg_dialogue_color"):
+		Engine.set_meta("gab_rpg_dialogue_color", 0)
+	background_opacity_slider.value = Engine.get_meta("gab_rpg_dialogue_opacity", 0.85)
+	text_color_option.select(Engine.get_meta("gab_rpg_dialogue_color", 0))
+	_apply_dialogue_appearance()
+
+
+func _on_background_opacity_changed(value: float) -> void:
+	Engine.set_meta("gab_rpg_dialogue_opacity", value)
+	_apply_dialogue_appearance()
+
+
+func _on_text_color_selected(index: int) -> void:
+	Engine.set_meta("gab_rpg_dialogue_color", index)
+	_apply_dialogue_appearance()
+
+
+func _apply_dialogue_appearance() -> void:
+	var tint: Color = $Panel2.self_modulate
+	tint.a = Engine.get_meta("gab_rpg_dialogue_opacity", 0.85)
+	$Panel2.self_modulate = tint
+	var colors := [Color.WHITE, Color(1.0, 0.9, 0.2), Color(0.3, 1.0, 1.0)]
+	var color: Color = colors[clampi(int(Engine.get_meta("gab_rpg_dialogue_color", 0)), 0, 2)]
+	$Text.add_theme_color_override("default_color", color)
+	$Name.add_theme_color_override("default_color", color)
 
 
 func show_dialogue(player: Pawn, dialogue: Node) -> void:
